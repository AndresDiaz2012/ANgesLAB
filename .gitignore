# ANgesLAB .gitignore
# Proteger datos sensibles y archivos generados

# Base de datos de produccion (contiene datos de pacientes)
ANgesLAB.accdb
ANgesLAB_Demo.accdb

# Configuracion con credenciales
config_ia.json
db_config.json
backup_config.json
config_portal.json
config_whatsapp.json

# Lock files de Access
*.laccdb
*.ldb

# Backups
backups/

# Logs
logs/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Instaladores compilados (se publican como GitHub Release, no en el repo)
*.exe

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Archivos temporales
*.tmp
*.bak
nul

# Scripts de mantenimiento one-time (mover a tools/)
limpiar_pruebas.py
limpiar_areas.py
limpiar_perfiles.py
temp_explorar.py
query_perfiles.py
diagnostico_historial.py
crear_gtt.py
perfiles_query_output.txt

# Archivos de firma (datos personales)
firmas/


# Desinstalador que deja Inno Setup en la instalacion
unins000.dat
unins000.msg

# Claude settings
.claude/
